{
  "name": "synchron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:scheduling": "node --experimental-strip-types scripts/verify-scheduling.ts",
    "check:projects": "node --experimental-strip-types scripts/verify-projects.ts",
    "check:project-context": "node --experimental-strip-types scripts/verify-project-context.ts",
    "check:project-resume": "node --experimental-strip-types scripts/verify-project-resume.ts",
    "check:project-activity": "node --experimental-strip-types scripts/verify-project-activity.ts",
    "check:action-projects": "node --experimental-strip-types scripts/verify-action-projects.ts",
    "check:home-overview": "node --experimental-strip-types scripts/verify-home-overview.ts",
    "check:project-visit": "node --experimental-strip-types scripts/verify-project-visit.ts",
    "check:project-lifecycle": "node --experimental-strip-types scripts/verify-project-lifecycle.ts",
    "check:project-stats": "node --experimental-strip-types scripts/verify-project-stats.ts",
    "check:search": "node --experimental-strip-types scripts/verify-search.ts",
    "check:project-links": "node --experimental-strip-types scripts/verify-project-links.ts",
    "check:dom": "node --experimental-strip-types scripts/verify-dom.ts",
    "check": "npm run -s check:scheduling && npm run -s check:projects && npm run -s check:project-context && npm run -s check:project-resume && npm run -s check:project-activity && npm run -s check:home-overview && npm run -s check:project-visit && npm run -s check:project-lifecycle && npm run -s check:project-stats && npm run -s check:search && npm run -s check:project-links && npm run -s check:action-projects && npm run -s check:dom && tsc --noEmit && npm run build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
